<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Arcade Hub - Unblocked Games</title>
    <style>
        :root {
            --bg-color: #0f1016;
            --card-bg: #1a1c29;
            --accent-color: #7289da;
            --text-color: #ffffff;
            --text-secondary: #99aab5;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: var(--bg-color);
            color: var(--text-color);
            margin: 0;
            padding: 0;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        header {
            background-color: var(--card-bg);
            padding: 20px;
            text-align: center;
            border-bottom: 2px solid #23272a;
        }

        header h1 {
            margin: 0;
            font-size: 2.5rem;
            color: var(--accent-color);
        }

        header p {
            margin: 5px 0 0;
            color: var(--text-secondary);
        }

        .search-container {
            padding: 20px;
            text-align: center;
        }

        #searchBar {
            width: 80%;
            max-width: 400px;
            padding: 12px 20px;
            font-size: 1rem;
            border-radius: 25px;
            border: 2px solid #23272a;
            background-color: var(--card-bg);
            color: var(--text-color);
            outline: none;
            transition: 0.3s;
        }

        #searchBar:focus {
            border-color: var(--accent-color);
        }

        .game-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
            gap: 20px;
            padding: 20px 40px;
            max-width: 1200px;
            margin: 0 auto;
            flex: 1;
            width: 100%;
            box-sizing: border-box;
        }

        .game-card {
            background-color: var(--card-bg);
            border-radius: 12px;
            overflow: hidden;
            text-decoration: none;
            color: var(--text-color);
            display: flex;
            flex-direction: column;
            transition: transform 0.2s, box-shadow 0.2s;
            border: 1px solid #23272a;
        }

        .game-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 20px rgba(114, 137, 218, 0.2);
            border-color: var(--accent-color);
        }

        .game-img {
            width: 100%;
            height: 130px;
            background-color: #2c2f33;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 3rem;
        }

        .game-info {
            padding: 15px;
            text-align: center;
        }

        .game-info h3 {
            margin: 0 0 5px;
            font-size: 1.1rem;
        }

        .game-info p {
            margin: 0;
            font-size: 0.85rem;
            color: var(--text-secondary);
        }

        footer {
            text-align: center;
            padding: 15px;
            background-color: var(--card-bg);
            color: var(--text-secondary);
            font-size: 0.85rem;
            border-top: 2px solid #23272a;
        }
    </style>
</head>
<body>

    <header>
        <h1>🎮 Arcade Hub</h1>
        <p>Bored in class? We got you.</p>
    </header>

    <div class="search-container">
        <input type="text" id="searchBar" placeholder="Search for a game..." onkeyup="searchGames()">
    </div>

    <div class="game-grid" id="gameGrid">
        <!-- Game 1: BitLife (Example embed/link style) -->
        <a href="https://bitlifeonline.io/" target="_blank" class="game-card" data-name="bitlife simulator">
            <div class="game-img">🧬</div>
            <div class="game-info">
                <h3>BitLife</h3>
                <p>Life Simulator</p>
            </div>
        </a>

        <!-- Game 2: Retro Bowl -->
        <a href="https://retrobowl.me/" target="_blank" class="game-card" data-name="retro bowl football">
            <div class="game-img">🏈</div>
            <div class="game-info">
                <h3>Retro Bowl</h3>
                <p>Football Management</p>
            </div>
        </a>

        <!-- Game 3: 2048 -->
        <a href="https://play2048.co/" target="_blank" class="game-card" data-name="2048 puzzle numbers">
            <div class="game-img">🔢</div>
            <div class="game-info">
                <h3>2048</h3>
                <p>Puzzle Game</p>
            </div>
        </a>

        <!-- Game 4: Slope -->
        <a href="https://kbhgames.com/game/slope" target="_blank" class="game-card" data-name="slope ball running">
            <div class="game-img">⛰️</div>
            <div class="game-info">
                <h3>Slope</h3>
                <p>Endless Runner</p>
            </div>
        </a>
    </div>

    <footer>
        <p>&copy; 2026 Arcade Hub. Built for the culture.</p>
    </footer>

    <script>
        function searchGames() {
            let input = document.getElementById('searchBar').value.toLowerCase();
            let cards = document.getElementsByClassName('game-card');

            for (let i = 0; i < cards.length; i++) {
                let name = cards[i].getAttribute('data-name');
                if (name.includes(input)) {
                    cards[i].style.display = "flex";
                } else {
                    cards[i].style.display = "none";
                }
            }
        }
    </script>

</body>
</html>
